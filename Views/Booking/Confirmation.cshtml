@model MovieBookingPro.DTOs.BookingDto
@{
    ViewData["Title"] = "Booking Confirmed";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="panel text-center">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 3rem;"></i>
                <h3 class="mt-3 mb-1">Booking Confirmed!</h3>
                <p class="text-muted mb-4">Your tickets have been booked successfully.</p>

                <div class="text-start">
                    <div class="d-flex justify-content-between border-bottom py-2" style="border-color: var(--border-color) !important;">
                        <span class="text-muted">Booking ID</span>
                        <span class="fw-semibold">#@Model.BookingId</span>
                    </div>
                    <div class="d-flex justify-content-between border-bottom py-2" style="border-color: var(--border-color) !important;">
                        <span class="text-muted">Movie</span>
                        <span class="fw-semibold">@Model.MovieTitle</span>
                    </div>
                    <div class="d-flex justify-content-between border-bottom py-2" style="border-color: var(--border-color) !important;">
                        <span class="text-muted">Theatre</span>
                        <span class="fw-semibold">@Model.TheatreName (@Model.ScreenName)</span>
                    </div>
                    <div class="d-flex justify-content-between border-bottom py-2" style="border-color: var(--border-color) !important;">
                        <span class="text-muted">Show</span>
                        <span class="fw-semibold">@Model.ShowDate.ToString("dd MMM yyyy") &bull; @Model.ShowTime.ToString(@"hh\:mm")</span>
                    </div>
                    <div class="d-flex justify-content-between border-bottom py-2" style="border-color: var(--border-color) !important;">
                        <span class="text-muted">Seats</span>
                        <span class="fw-semibold">@Model.SeatCount</span>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span class="text-muted">Total Paid</span>
                        <span class="fw-semibold">₹@Model.TotalAmount</span>
                    </div>
                </div>

                <a asp-controller="Booking" asp-action="MyBookings" class="btn btn-primary-cinema w-100 mt-4">View My Bookings</a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light w-100 mt-2">Back to Home</a>
            </div>
        </div>
    </div>
</div>
