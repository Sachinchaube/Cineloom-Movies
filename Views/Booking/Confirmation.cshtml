@model MovieBookingPro.DTOs.BookingDto
@{
    ViewData["Title"] = "Ticket Confirmed - CineLoom";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <!-- Digital Cinema Pass -->
            <div class="ticket-pass">
                <div class="ticket-pass-header">
                    <div class="d-flex align-items-center justify-content-center gap-2 mb-2">
                        <span class="brand-logo-icon" style="width: 28px; height: 28px; font-size: 0.85rem; background: rgba(255,255,255,0.25);"><i class="bi bi-film"></i></span>
                        <h4 class="mb-0 font-grotesk fw-bold">CineLoom VIP Pass</h4>
                    </div>
                    <span class="badge bg-white text-danger fw-bold text-uppercase px-3 py-1">Booking Confirmed</span>
                </div>

                <div class="ticket-pass-body">
                    <div class="text-center mb-4">
                        <h3 class="fw-extrabold text-light mb-1">@Model.MovieTitle</h3>
                        <p class="text-muted small mb-0">Present this digital pass at the cinema hall entrance</p>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <span class="text-muted small d-block">Cinema Complex</span>
                            <strong class="text-light fs-6">@Model.TheatreName</strong>
                        </div>
                        <div class="col-6 text-end">
                            <span class="text-muted small d-block">Screen</span>
                            <strong class="text-info fs-6">@Model.ScreenName</strong>
                        </div>
                        <div class="col-6">
                            <span class="text-muted small d-block">Date & Showtime</span>
                            <strong class="text-light fs-6">@Model.ShowDate.ToString("dd MMM yyyy") &bull; @Model.ShowTime.ToString(@"hh\:mm")</strong>
                        </div>
                        <div class="col-6 text-end">
                            <span class="text-muted small d-block">Seats Reserved</span>
                            <strong class="text-danger fs-5">@Model.SeatCount Seat(s)</strong>
                        </div>
                    </div>

                    <!-- Perforation Line -->
                    <div class="ticket-perforation">
                        <div class="ticket-perforation-line"></div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <span class="text-muted small d-block">Booking Reference</span>
                            <span class="font-grotesk fw-bold text-light fs-5">#CIN-@Model.BookingId.ToString("D5")</span>
                        </div>
                        <div class="text-end">
                            <span class="text-muted small d-block">Total Amount Paid</span>
                            <span class="fw-bold text-success fs-4">₹@Model.TotalAmount</span>
                        </div>
                    </div>

                    <!-- Simulated QR Ticket Code -->
                    <div class="text-center p-3 rounded-3 bg-dark border border-secondary border-opacity-25 mb-4">
                        <div class="d-flex justify-content-center gap-1 mb-2">
                            <i class="bi bi-qr-code fs-1 text-light"></i>
                        </div>
                        <span class="text-muted small">Scan for instant barcode entry at turnstiles</span>
                    </div>

                    <div class="d-flex gap-3 flex-wrap">
                        <a asp-controller="Booking" asp-action="MyBookings" class="btn btn-primary-cinema flex-grow-1 py-2">
                            <i class="bi bi-ticket-detailed me-1"></i> View All Tickets
                        </a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-glass flex-grow-1 py-2">
                            <i class="bi bi-house-door me-1"></i> Back to Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

