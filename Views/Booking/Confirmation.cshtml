@model MovieBookingPro.DTOs.BookingDto
@{
    ViewData["Title"] = "Booking Confirmation";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="ticket-receipt shadow-lg">
                <div class="ticket-receipt-head text-center">
                    <span class="badge-confirmed d-inline-block mb-2">Booking Confirmed</span>
                    <h4 class="text-light fw-bold mb-0">CineLoom Admission Pass</h4>
                </div>

                <div class="ticket-receipt-body">
                    <div class="text-center mb-4">
                        <h3 class="fw-bold text-light mb-1">@Model.MovieTitle</h3>
                        <p class="text-muted small mb-0">Present this pass at the theatre entrance</p>
                    </div>

                    <div class="row g-3 mb-2">
                        <div class="col-6">
                            <span class="text-muted small d-block">Theatre</span>
                            <strong class="text-light">@Model.TheatreName</strong>
                        </div>
                        <div class="col-6 text-end">
                            <span class="text-muted small d-block">Auditorium / Screen</span>
                            <strong class="text-light">@Model.ScreenName</strong>
                        </div>
                        <div class="col-6">
                            <span class="text-muted small d-block">Date & Showtime</span>
                            <strong class="text-light">@Model.ShowDate.ToString("dd MMM yyyy") &bull; @Model.ShowTime.ToString(@"hh\:mm")</strong>
                        </div>
                        <div class="col-6 text-end">
                            <span class="text-muted small d-block">Tickets</span>
                            <strong class="text-gold">@Model.SeatCount Seat(s)</strong>
                        </div>
                    </div>

                    <div class="ticket-divider"></div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <span class="text-muted small d-block">Booking Reference</span>
                            <span class="font-brand fw-bold text-light fs-5">#CIN-@Model.BookingId.ToString("D5")</span>
                        </div>
                        <div class="text-end">
                            <span class="text-muted small d-block">Total Paid</span>
                            <span class="fw-bold text-gold fs-4">₹@Model.TotalAmount</span>
                        </div>
                    </div>

                    <div class="text-center p-3 rounded-2 bg-dark border border-secondary border-opacity-25 mb-4">
                        <div class="text-muted small">Barcode reference for automated turnstile entry</div>
                        <div class="text-light fw-bold font-monospace fs-6 mt-1">CIN-@Model.BookingId.ToString("D5")-@Model.ShowId-@Model.SeatCount</div>
                    </div>

                    <div class="d-flex gap-3 flex-wrap">
                        <a asp-controller="Booking" asp-action="MyBookings" class="btn btn-cinema-gold flex-grow-1 py-2">
                            View All Bookings
                        </a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-cinema-subtle flex-grow-1 py-2">
                            Return Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
