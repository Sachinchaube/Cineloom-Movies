@model MovieBookingPro.DTOs.ShowScheduleDto
@{
    ViewData["Title"] = "Book Tickets";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="panel">
                <h4 class="mb-1">@Model.MovieTitle</h4>
                <p class="text-muted mb-4">
                    @Model.TheatreName &bull; @Model.ScreenName<br />
                    @Model.ShowDate.ToString("dd MMM yyyy") &bull; @Model.ShowTime.ToString(@"hh\:mm")
                </p>

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted">Price per seat</span>
                    <span class="fw-semibold">₹@Model.Price</span>
                </div>
                <div class="d-flex justify-content-between mb-4">
                    <span class="text-muted">Seats available</span>
                    <span class="fw-semibold">@Model.SeatsAvailable</span>
                </div>

                <form asp-controller="Booking" asp-action="Insert" method="post">
                    <input type="hidden" name="ShowId" value="@Model.ShowId" />

                    <div class="mb-4">
                        <label>Number of seats</label>
                        <input type="number" name="SeatCount" class="form-control" min="1" max="@Math.Min(10, Model.SeatsAvailable)" value="1" required />
                    </div>

                    <button type="submit" class="btn btn-primary-cinema w-100" @(Model.SeatsAvailable == 0 ? "disabled" : "")>
                        @(Model.SeatsAvailable == 0 ? "Sold Out" : "Confirm Booking")
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
