@model MovieBookingPro.DTOs.ShowScheduleDto
@{
    ViewData["Title"] = "Select Seats";
}

<div class="container py-5">
    <div class="row g-5">
        <!-- Cinema Hall Seat Matrix -->
        <div class="col-lg-8">
            <div class="cinema-hall-box">
                <div class="cinema-screen-bar"></div>
                <div class="cinema-screen-caption">Auditorium Screen Area</div>

                <!-- Seat Grid -->
                <div class="seat-grid" id="seatLayout">
                    @{
                        char[] rows = { 'A', 'B', 'C', 'D', 'E', 'F' };
                        int seatsPerRow = 10;
                    }
                    @for (int r = 0; r < rows.Length; r++)
                    {
                        <div class="seat-row">
                            <span class="seat-row-label">@rows[r]</span>
                            <div class="d-flex gap-2">
                                @for (int s = 1; s <= seatsPerRow; s++)
                                {
                                    bool isBooked = (r * 10 + s) % 7 == 0;
                                    <div class="seat-unit @(isBooked ? "seat-booked" : "")" 
                                         data-seat="@(rows[r])@s" 
                                         data-booked="@(isBooked ? "true" : "false")"
                                         title="@(isBooked ? "Seat " + rows[r] + s + " (Occupied)" : "Seat " + rows[r] + s)">
                                        @s
                                    </div>
                                }
                            </div>
                            <span class="seat-row-label">@rows[r]</span>
                        </div>
                    }
                </div>

                <!-- Legend -->
                <div class="d-flex justify-content-center gap-4 pt-3 border-top" style="border-color: var(--border-subtle) !important;">
                    <div class="d-flex align-items-center gap-2 small text-muted">
                        <div class="seat-unit" style="cursor: default;"></div>
                        <span>Available</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 small text-muted">
                        <div class="seat-unit seat-selected" style="cursor: default;"></div>
                        <span>Selected</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 small text-muted">
                        <div class="seat-unit seat-booked" style="cursor: default;"></div>
                        <span>Occupied</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Booking Summary -->
        <div class="col-lg-4">
            <div class="panel sticky-top" style="top: 85px;">
                <div class="pb-3 mb-3 border-bottom" style="border-color: var(--border-subtle) !important;">
                    <span class="text-gold fw-bold text-uppercase small" style="letter-spacing: 0.05em;">Step 2</span>
                    <h4 class="text-light fw-bold mb-1">Booking Summary</h4>
                </div>

                <div class="mb-4">
                    <h5 class="text-light fw-bold mb-1">@Model.MovieTitle</h5>
                    <p class="text-muted small mb-0">
                        @Model.TheatreName &bull; <span class="text-light">@Model.ScreenName</span><br />
                        @Model.ShowDate.ToString("ddd, dd MMM yyyy") &bull; @Model.ShowTime.ToString(@"hh\:mm")
                    </p>
                </div>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="d-flex justify-content-between align-items-center py-2 border-bottom" style="border-color: var(--border-subtle) !important;">
                    <span class="text-muted">Price per seat</span>
                    <span class="fw-bold text-light">₹@Model.Price</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom" style="border-color: var(--border-subtle) !important;">
                    <span class="text-muted">Seats available</span>
                    <span class="text-success fw-bold">@Model.SeatsAvailable Left</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom" style="border-color: var(--border-subtle) !important;">
                    <span class="text-muted">Selected Seats</span>
                    <span class="text-gold fw-bold" id="selectedSeatsLabel">1 Seat</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-3 mb-4">
                    <span class="fs-5 fw-bold text-light">Total Payable</span>
                    <span class="fs-4 fw-bold text-gold" id="totalPriceLabel">₹@Model.Price</span>
                </div>

                <form asp-controller="Booking" asp-action="Insert" method="post">
                    <input type="hidden" name="ShowId" value="@Model.ShowId" />

                    <div class="mb-4">
                        <label class="form-label">Number of Tickets</label>
                        <input type="number" id="seatCountInput" name="SeatCount" class="form-control" min="1" max="@Math.Min(10, Model.SeatsAvailable)" value="1" required />
                        <small class="text-muted">Maximum 10 tickets per transaction</small>
                    </div>

                    <button type="submit" class="btn btn-cinema-gold w-100 py-2 fs-6" @(Model.SeatsAvailable == 0 ? "disabled" : "")>
                        @(Model.SeatsAvailable == 0 ? "Sold Out" : "Confirm Booking")
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const unitPrice = @Model.Price;
        const seatCountInput = document.getElementById("seatCountInput");
        const totalPriceLabel = document.getElementById("totalPriceLabel");
        const selectedSeatsLabel = document.getElementById("selectedSeatsLabel");
        const seatItems = document.querySelectorAll(".seat-unit[data-booked='false']");

        function updateTotals() {
            let count = parseInt(seatCountInput.value) || 1;
            if (count < 1) count = 1;
            let total = count * unitPrice;
            totalPriceLabel.textContent = "₹" + total.toFixed(2);
            selectedSeatsLabel.textContent = count + " Seat" + (count > 1 ? "s" : "");

            seatItems.forEach((seat, idx) => {
                if (idx < count) {
                    seat.classList.add("seat-selected");
                } else {
                    seat.classList.remove("seat-selected");
                }
            });
        }

        seatItems.forEach((seat, idx) => {
            seat.addEventListener("click", function () {
                seatCountInput.value = Math.min(idx + 1, @Math.Min(10, Model.SeatsAvailable));
                updateTotals();
            });
        });

        seatCountInput.addEventListener("input", updateTotals);
        updateTotals();
    });
</script>
}
