@model List<MovieBookingPro.DTOs.BookingDto>
@{
    ViewData["Title"] = "My Tickets & Bookings";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-secondary border-opacity-25">
        <div>
            <span class="text-danger fw-bold text-uppercase small">Your History</span>
            <h2 class="mb-0 mt-1">My Cinema Bookings</h2>
        </div>
        <a asp-controller="Movie" asp-action="Index" class="btn btn-primary-cinema btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Book New Show
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="panel text-center py-5">
            <i class="bi bi-ticket-perforated fs-1 text-muted d-block mb-3"></i>
            <h4 class="text-light">No Bookings Yet</h4>
            <p class="text-muted mb-4">You haven't reserved any movie tickets yet. Explore movies to book your first show!</p>
            <a asp-controller="Movie" asp-action="Index" class="btn btn-primary-cinema px-4">Browse Now Showing</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var booking in Model)
            {
                <div class="col-lg-6">
                    <div class="panel h-100 position-relative overflow-hidden" style="border-left: 4px solid @(booking.Status == "Confirmed" ? "var(--success)" : "var(--danger)");">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <div>
                                <span class="text-muted small font-grotesk">#CIN-@booking.BookingId.ToString("D5")</span>
                                <h4 class="text-light fw-bold mb-1">@booking.MovieTitle</h4>
                                <p class="text-muted small mb-0">
                                    <i class="bi bi-geo-alt text-danger me-1"></i>@booking.TheatreName &bull; <span class="text-info">@booking.ScreenName</span>
                                </p>
                            </div>
                            <div>
                                @if (booking.Status == "Confirmed")
                                {
                                    <span class="badge-confirmed"><i class="bi bi-check-circle me-1"></i>Confirmed</span>
                                }
                                else
                                {
                                    <span class="badge-cancelled"><i class="bi bi-x-circle me-1"></i>Cancelled</span>
                                }
                            </div>
                        </div>

                        <div class="p-3 rounded-3 bg-dark border border-secondary border-opacity-25 mb-3">
                            <div class="row g-2 small">
                                <div class="col-6">
                                    <span class="text-muted d-block">Showtime:</span>
                                    <strong class="text-light">@booking.ShowDate.ToString("dd MMM yyyy") @booking.ShowTime.ToString(@"hh\:mm")</strong>
                                </div>
                                <div class="col-6 text-end">
                                    <span class="text-muted d-block">Seats:</span>
                                    <strong class="text-danger">@booking.SeatCount Seat(s)</strong>
                                </div>
                                <div class="col-6 mt-2">
                                    <span class="text-muted d-block">Total Paid:</span>
                                    <strong class="text-success fs-6">₹@booking.TotalAmount</strong>
                                </div>
                                <div class="col-6 text-end mt-2">
                                    <span class="text-muted d-block">Booked on:</span>
                                    <span class="text-muted">@booking.BookingDate.ToString("dd MMM yyyy")</span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-controller="Booking" asp-action="Confirmation" asp-route-id="@booking.BookingId" class="btn btn-glass btn-sm">
                                <i class="bi bi-qr-code me-1"></i> View Ticket Pass
                            </a>
                            @if (booking.Status == "Confirmed")
                            {
                                <form asp-controller="Booking" asp-action="Cancel" asp-route-id="@booking.BookingId" method="post" onsubmit="return confirm('Are you sure you want to cancel this booking?');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                        <i class="bi bi-x-lg me-1"></i> Cancel
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

