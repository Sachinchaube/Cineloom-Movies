@model List<MovieBookingPro.DTOs.BookingDto>
@{
    ViewData["Title"] = "My Bookings";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom" style="border-color: var(--border-subtle) !important;">
        <div>
            <span class="text-gold fw-bold text-uppercase small" style="letter-spacing: 0.05em;">History</span>
            <h2 class="mb-0 mt-1">My Movie Bookings</h2>
        </div>
        <a asp-controller="Movie" asp-action="Index" class="btn btn-cinema-gold btn-sm">
            Book New Show
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="panel text-center py-5">
            <i class="bi bi-ticket-perforated fs-1 text-muted d-block mb-3"></i>
            <h4 class="text-light">No Bookings Found</h4>
            <p class="text-muted mb-4">You have not booked any movie tickets yet.</p>
            <a asp-controller="Movie" asp-action="Index" class="btn btn-cinema-gold px-4">Browse Now Showing</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var booking in Model)
            {
                <div class="col-lg-6">
                    <div class="panel h-100 position-relative" style="border-left: 3px solid @(booking.Status == "Confirmed" ? "var(--status-confirmed)" : "var(--status-cancelled)");">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <div>
                                <span class="text-muted small font-monospace">#NEST-@booking.BookingId.ToString("D5")</span>
                                <h4 class="text-light fw-bold mb-1">@booking.MovieTitle</h4>
                                <p class="text-muted small mb-0">
                                    @booking.TheatreName &bull; @booking.ScreenName
                                </p>
                            </div>
                            <div>
                                @if (booking.Status == "Confirmed")
                                {
                                    <span class="badge-confirmed">Confirmed</span>
                                }
                                else
                                {
                                    <span class="badge-cancelled">Cancelled</span>
                                }
                            </div>
                        </div>

                        <div class="p-3 rounded-2 bg-dark border border-secondary border-opacity-25 mb-3">
                            <div class="row g-2 small">
                                <div class="col-6">
                                    <span class="text-muted d-block">Showtime:</span>
                                    <strong class="text-light">@booking.ShowDate.ToString("dd MMM yyyy") @booking.ShowTime.ToString(@"hh\:mm")</strong>
                                </div>
                                <div class="col-6 text-end">
                                    <span class="text-muted d-block">Reserved Seats:</span>
                                    <strong class="text-gold">@booking.SeatCount Seat(s)</strong>
                                </div>
                                <div class="col-6 mt-2">
                                    <span class="text-muted d-block">Total Paid:</span>
                                    <strong class="text-gold">₹@booking.TotalAmount</strong>
                                </div>
                                <div class="col-6 text-end mt-2">
                                    <span class="text-muted d-block">Booking Date:</span>
                                    <span class="text-muted">@booking.BookingDate.ToString("dd MMM yyyy")</span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-controller="Booking" asp-action="Confirmation" asp-route-id="@booking.BookingId" class="btn btn-cinema-subtle btn-sm">
                                View Ticket Pass
                            </a>
                            @if (booking.Status == "Confirmed")
                            {
                                <form asp-controller="Booking" asp-action="Cancel" asp-route-id="@booking.BookingId" method="post" onsubmit="return confirm('Cancel this ticket booking?');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                        Cancel Booking
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
