@using Microsoft.AspNetCore.Identity
@using MovieBookingPro.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CineLoom</title>
    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-cinema">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-logo-icon"><i class="bi bi-film"></i></span>
                    Cine<span>Loom</span>
                </a>
                <button class="navbar-toggler border-0 text-light" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-2 text-light"></i>
                </button>
                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav me-auto ps-lg-3 gap-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i>Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Movie" asp-action="Index">
                                <i class="bi bi-camera-reels me-1"></i>Explore Movies
                            </a>
                        </li>
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Booking" asp-action="MyBookings">
                                    <i class="bi bi-ticket-perforated me-1"></i>My Tickets
                                </a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-lg-center gap-2 mt-3 mt-lg-0">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="btn btn-glass btn-sm" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                        <i class="bi bi-speedometer2 text-danger me-1"></i>Admin Panel
                                    </a>
                                </li>
                            }
                            <li class="nav-item d-flex align-items-center me-2 text-light small px-2 py-1 rounded bg-dark border border-secondary border-opacity-25">
                                <i class="bi bi-person-circle fs-5 me-2 text-danger"></i>
                                <div>
                                    <span class="d-block fw-semibold" style="line-height: 1.2;">@User.Identity?.Name</span>
                                    <span class="text-muted" style="font-size: 0.7rem;">Member</span>
                                </div>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-light btn-sm px-3 rounded-pill">
                                        <i class="bi bi-box-arrow-right me-1"></i>Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-glass btn-sm px-3" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Log In
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary-cinema btn-sm px-3" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-stars me-1"></i>Get Started
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="brand-logo-icon" style="width: 30px; height: 30px; font-size: 0.9rem;"><i class="bi bi-film"></i></span>
                        <h5 class="mb-0 font-grotesk">Cine<span class="text-danger">Loom</span></h5>
                    </div>
                    <p class="text-muted small pe-lg-4">The next-generation cinema ticketing experience. Discover premieres, book luxury seats, and enjoy cinematic brilliance.</p>
                </div>
                <div class="col-lg-2 col-6">
                    <h6 class="text-light fw-bold mb-3">Navigation</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2 mb-0">
                        <li><a asp-controller="Home" asp-action="Index" class="text-muted">Home</a></li>
                        <li><a asp-controller="Movie" asp-action="Index" class="text-muted">Now Showing</a></li>
                        <li><a asp-controller="Booking" asp-action="MyBookings" class="text-muted">My Bookings</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-6">
                    <h6 class="text-light fw-bold mb-3">Formats & Sound</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2 mb-0 text-muted">
                        <li><i class="bi bi-check2 text-danger me-1"></i>IMAX 4K Laser</li>
                        <li><i class="bi bi-check2 text-danger me-1"></i>Dolby Atmos Surround</li>
                        <li><i class="bi bi-check2 text-danger me-1"></i>Gold Class Recliners</li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="text-light fw-bold mb-3">Cinema Experience</h6>
                    <p class="text-muted small mb-2"><i class="bi bi-geo-alt text-danger me-2"></i>Multi-city luxury theatres</p>
                    <p class="text-muted small mb-0"><i class="bi bi-shield-check text-success me-2"></i>Instant QR Ticket Confirmation</p>
                </div>
            </div>
            <div class="border-top border-secondary border-opacity-25 pt-4 d-flex justify-content-between flex-wrap gap-2 small text-muted">
                <span>&copy; @DateTime.Now.Year CineLoom. All rights reserved.</span>
                <span>Designed & Engineered for Premium Cinema Experience</span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.3/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>