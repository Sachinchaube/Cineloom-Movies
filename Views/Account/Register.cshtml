@model RegisterViewModel
@{
    ViewData["Title"] = "Sign Up";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <h3 class="mb-1">Create your account</h3>
        <p class="text-muted mb-4">Sign up to start booking movie tickets.</p>

        <form asp-controller="Account" asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="FullName"></label>
                <input asp-for="FullName" class="form-control" placeholder="John Doe" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" placeholder="john@example.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-control" placeholder="At least 6 characters" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary-cinema w-100">Sign Up</button>
        </form>

        <p class="text-center text-muted mt-4 mb-0">
            Already have an account? <a asp-controller="Account" asp-action="Login">Log in</a>
        </p>
    </div>
</div>
