@model LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="container py-5">
    <div class="row justify-content-center align-items-center" style="min-height: 65vh;">
        <div class="col-md-7 col-lg-5">
            <div class="panel p-4 p-md-5 shadow-lg">
                <div class="text-center mb-4">
                    <div class="brand-mark mb-2 mx-auto" style="width: 36px; height: 36px; font-size: 1.1rem;"><i class="bi bi-film"></i></div>
                    <h3 class="fw-bold text-light mb-1">Account Sign In</h3>
                    <p class="text-muted small">Sign in to manage bookings and view admission passes</p>
                </div>

                <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label text-light small fw-bold">Email Address</label>
                        <input asp-for="Email" id="emailInput" class="form-control" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label text-light small fw-bold">Password</label>
                        <input asp-for="Password" id="passwordInput" type="password" class="form-control" placeholder="Password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label text-muted small"></label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-cinema-gold w-100 py-2 fs-6 mb-3">
                        Sign In
                    </button>
                </form>

                <!-- Demo Accounts Helper -->
                <div class="p-3 rounded-2 bg-dark border border-secondary border-opacity-25 text-center mt-3">
                    <span class="text-muted d-block small mb-2">Demo Credentials</span>
                    <div class="d-flex justify-content-center gap-2">
                        <button type="button" class="btn btn-sm btn-cinema-subtle px-3" onclick="fillCreds('admin@movienest.com', 'Admin@123')">
                            Admin Account
                        </button>
                        <button type="button" class="btn btn-sm btn-cinema-subtle px-3" onclick="fillCreds('customer@movienest.com', 'Customer@123')">
                            Customer Account
                        </button>
                    </div>
                </div>

                <div class="text-center text-muted small mt-4">
                    Do not have an account? <a asp-controller="Account" asp-action="Register" class="text-gold fw-bold">Register</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function fillCreds(email, password) {
        document.getElementById('emailInput').value = email;
        document.getElementById('passwordInput').value = password;
    }
</script>
}
