@model LoginViewModel
@{
    ViewData["Title"] = "Login to CineLoom";
}

<div class="container py-5">
    <div class="row justify-content-center align-items-center min-vh-75">
        <div class="col-md-7 col-lg-5">
            <div class="panel p-4 p-md-5 shadow-lg border border-secondary border-opacity-25 position-relative overflow-hidden">
                <div class="text-center mb-4">
                    <span class="brand-logo-icon mb-2 d-inline-flex" style="width: 44px; height: 44px; font-size: 1.3rem;"><i class="bi bi-film"></i></span>
                    <h3 class="fw-bold text-light mb-1">Welcome Back</h3>
                    <p class="text-muted small">Log in to book luxury seats & access digital passes</p>
                </div>

                <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label text-light small fw-bold">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary border-opacity-25 text-muted"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" id="emailInput" class="form-control" placeholder="name@example.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label text-light small fw-bold">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary border-opacity-25 text-muted"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" id="passwordInput" type="password" class="form-control" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label text-muted small"></label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary-cinema w-100 py-2 fs-6 mb-3">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                    </button>
                </form>

                <!-- Quick Demo Fill Helper -->
                <div class="p-3 rounded-3 bg-dark border border-secondary border-opacity-25 text-center mt-3">
                    <small class="text-muted d-block mb-2">⚡ Quick Demo Logins</small>
                    <div class="d-flex justify-content-center gap-2">
                        <button type="button" class="btn btn-sm btn-outline-danger px-2" onclick="fillCreds('admin@cinebook.com', 'Admin@123')">
                            Admin Account
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-light px-2" onclick="fillCreds('customer@cinebook.com', 'Customer@123')">
                            Customer Demo
                        </button>
                    </div>
                </div>

                <div class="text-center text-muted small mt-4">
                    Don't have an account? <a asp-controller="Account" asp-action="Register" class="text-danger fw-bold">Create Account</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function fillCreds(email, password) {
        document.getElementById('emailInput').value = email;
        document.getElementById('passwordInput').value = password;
    }
</script>
}

