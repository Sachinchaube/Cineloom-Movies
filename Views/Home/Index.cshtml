@model List<MovieBookingPro.Models.Movie>
@{
    ViewData["Title"] = "Now Showing - Movies & Tickets";
    var featured = Model.FirstOrDefault();
}

<!-- Featured Spotlight Hero -->
<section class="hero-cinema">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <div class="hero-kicker">
                    <i class="bi bi-camera-reels"></i> Box Office Premiere
                </div>
                <h1 class="hero-heading">
                    Book Movie Tickets Online with Ease
                </h1>
                <p class="hero-text">
                    Browse the latest releases, find showtimes at top multiplexes near you, select your preferred seats, and get instant digital passes.
                </p>

                <!-- Search Input -->
                <form asp-controller="Movie" asp-action="Index" method="get" class="search-box-cinema mb-4">
                    <i class="bi bi-search text-muted ms-2"></i>
                    <input type="text" name="search" class="form-control" placeholder="Search by movie title, language or genre..." />
                    <button type="submit" class="btn-search">
                        Search Shows
                    </button>
                </form>

                <div class="d-flex align-items-center gap-4 text-muted small">
                    <div><i class="bi bi-check-circle text-gold me-1"></i> Instant Confirmation</div>
                    <div><i class="bi bi-check-circle text-gold me-1"></i> Reserved Seating</div>
                    <div><i class="bi bi-check-circle text-gold me-1"></i> Flexible Cancellation</div>
                </div>
            </div>

            @if (featured != null)
            {
                <div class="col-lg-5 text-center text-lg-end">
                    <div class="d-inline-block position-relative text-start" style="max-width: 320px;">
                        <a asp-controller="Movie" asp-action="Details" asp-route-id="@featured.MovieId" class="text-decoration-none">
                            <div class="movie-card shadow-lg">
                                <div class="movie-poster-wrap">
                                    <span class="badge-rating">
                                        <i class="bi bi-star-fill"></i> 9.2
                                    </span>
                                    <img src="@(string.IsNullOrWhiteSpace(featured.PosterUrl) ? "https://placehold.co/400x600/101622/94a3b8?text=" + Uri.EscapeDataString(featured.Title) : featured.PosterUrl)" class="movie-poster" alt="@featured.Title" />
                                    <div class="movie-poster-overlay">
                                        <div class="btn btn-cinema-gold w-100 btn-sm">
                                            Select Showtimes
                                        </div>
                                    </div>
                                </div>
                                <div class="movie-card-body">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="badge-genre genre-active">Featured Release</span>
                                        <span class="text-muted small">@featured.DurationInMinutes min</span>
                                    </div>
                                    <h5 class="movie-card-title mt-1 mb-0">@featured.Title</h5>
                                    <div class="text-muted small">@featured.Language &bull; @featured.Genre</div>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Now Showing Catalog -->
<section class="py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4 pb-2 border-bottom" style="border-color: var(--border-subtle) !important;">
            <div>
                <span class="text-gold fw-bold text-uppercase small" style="letter-spacing: 0.05em;">Current Schedule</span>
                <h2 class="mb-0 mt-1">Now Showing in Theatres</h2>
            </div>
            <a asp-controller="Movie" asp-action="Index" class="btn btn-cinema-subtle btn-sm">
                View Full Catalog <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row g-4">
            @foreach (var movie in Model)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <a asp-controller="Movie" asp-action="Details" asp-route-id="@movie.MovieId" class="text-decoration-none h-100 d-block">
                        <div class="movie-card">
                            <div class="movie-poster-wrap">
                                <span class="badge-rating">
                                    <i class="bi bi-star-fill"></i> 9.@((movie.MovieId * 2 + 1) % 9)
                                </span>
                                <img src="@(string.IsNullOrWhiteSpace(movie.PosterUrl) ? "https://placehold.co/400x600/101622/94a3b8?text=" + Uri.EscapeDataString(movie.Title) : movie.PosterUrl)" class="movie-poster" alt="@movie.Title" />
                                <div class="movie-poster-overlay">
                                    <div class="btn btn-cinema-gold btn-sm w-100">
                                        Book Tickets
                                    </div>
                                </div>
                            </div>
                            <div class="movie-card-body">
                                <h5 class="movie-card-title" title="@movie.Title">@movie.Title</h5>
                                <div class="movie-card-meta">
                                    <span>@movie.Language</span>
                                    <span>&bull;</span>
                                    <span>@movie.DurationInMinutes min</span>
                                </div>
                                <div class="mt-auto d-flex justify-content-between align-items-center">
                                    <span class="badge-genre">@movie.Genre</span>
                                    <span class="text-muted small">@movie.ReleaseDate.ToString("yyyy")</span>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</section>
