@{
    ViewData["Title"] = "Error";
}
<div class="container py-5 text-center">
    <h1 class="text-danger"><i class="bi bi-exclamation-triangle"></i> Something went wrong</h1>
    <p class="text-muted">An unexpected error occurred while processing your request.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary-cinema">Go Home</a>
</div>
