@{
    var movie = (MovieBookingPro.DTOs.MovieDto)ViewBag.Movie;
    var shows = (List<MovieBookingPro.DTOs.ShowScheduleDto>)ViewBag.Shows;
    var recommendations = (List<MovieBookingPro.DTOs.MovieDto>)ViewBag.Recommendations;
    ViewData["Title"] = movie.Title;
}

<!-- Movie Backdrop & Header Hero -->
<div class="position-relative py-5 border-bottom" style="background: linear-gradient(180deg, rgba(7, 9, 14, 0.4) 0%, #07090e 100%), url('@(string.IsNullOrWhiteSpace(movie.PosterUrl) ? "" : movie.PosterUrl)') center/cover no-repeat; border-color: var(--border-subtle) !important;">
    <div class="container position-relative py-4" style="z-index: 2;">
        <div class="row g-5 align-items-center">
            <div class="col-md-4 col-lg-3 text-center text-md-start">
                <div class="position-relative d-inline-block shadow-lg rounded-4 overflow-hidden" style="border: 2px solid rgba(255, 255, 255, 0.15);">
                    <img src="@(string.IsNullOrWhiteSpace(movie.PosterUrl) ? "https://placehold.co/400x600/1a1d24/9aa0ab?text=" + Uri.EscapeDataString(movie.Title) : movie.PosterUrl)" class="img-fluid" alt="@movie.Title" style="aspect-ratio: 2/3; object-fit: cover; max-height: 420px;" />
                </div>
            </div>
            <div class="col-md-8 col-lg-9">
                <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                    <span class="badge bg-danger fw-bold px-3 py-2 text-uppercase">Now Showing</span>
                    <span class="badge-genre genre-primary px-3 py-1">@movie.Genre</span>
                    <span class="badge-rating"><i class="bi bi-star-fill text-warning"></i> 9.3 / 10</span>
                </div>
                <h1 class="display-4 fw-extrabold text-light mb-3">@movie.Title</h1>
                <div class="d-flex flex-wrap gap-4 text-muted mb-4 fs-6">
                    <div><i class="bi bi-translate text-danger me-1"></i> <strong class="text-light">@movie.Language</strong></div>
                    <div><i class="bi bi-clock text-danger me-1"></i> <strong class="text-light">@movie.DurationInMinutes min</strong></div>
                    <div><i class="bi bi-calendar-event text-danger me-1"></i> Released <strong class="text-light">@movie.ReleaseDate.ToString("dd MMM yyyy")</strong></div>
                </div>
                @if (!string.IsNullOrWhiteSpace(movie.Description))
                {
                    <p class="text-light text-opacity-75 fs-5 mb-4" style="max-width: 800px; line-height: 1.7;">@movie.Description</p>
                }
                <div class="d-flex flex-wrap gap-3">
                    <a href="#showtimesSection" class="btn btn-primary-cinema px-4 py-2">
                        <i class="bi bi-ticket-perforated fs-5"></i> Select Showtime & Book
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container py-5" id="showtimesSection">
    <!-- Showtimes Section Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <span class="text-danger fw-bold text-uppercase small">Step 1: Pick a Show</span>
            <h2 class="mb-0 mt-1">Available Theatres & Showtimes</h2>
        </div>
        <div class="text-muted small">
            <i class="bi bi-info-circle me-1"></i> Real-time seat availability
        </div>
    </div>

    @if (shows == null || shows.Count == 0)
    {
        <div class="panel text-center py-5">
            <i class="bi bi-calendar-x fs-1 text-muted d-block mb-3"></i>
            <h5 class="text-light">No Upcoming Shows Scheduled</h5>
            <p class="text-muted mb-0">There are no shows scheduled for this movie currently. Please check back shortly.</p>
        </div>
    }
    else
    {
        var groupedByTheatre = shows.GroupBy(s => s.TheatreName);
        foreach (var theatreGroup in groupedByTheatre)
        {
            <div class="panel mb-4 p-4">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 pb-3 mb-3 border-bottom border-secondary border-opacity-25">
                    <div class="d-flex align-items-center gap-2">
                        <div class="p-2 rounded bg-danger bg-opacity-10 text-danger fs-5">
                            <i class="bi bi-building"></i>
                        </div>
                        <div>
                            <h5 class="mb-0 text-light fw-bold">@theatreGroup.Key</h5>
                            <small class="text-muted"><i class="bi bi-geo-alt me-1"></i>Luxury Cinema Multiplex</small>
                        </div>
                    </div>
                    <span class="badge bg-dark border border-secondary border-opacity-50 text-muted px-3 py-2">
                        <i class="bi bi-tv me-1 text-info"></i>Dolby Atmos & Laser
                    </span>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    @foreach (var show in theatreGroup)
                    {
                        <div class="showtime-pill @(show.SeatsAvailable == 0 ? "sold-out" : "")">
                            @if (show.SeatsAvailable > 0)
                            {
                                <a asp-controller="Booking" asp-action="Create" asp-route-showId="@show.ShowId" class="text-decoration-none">
                                    <div class="d-flex justify-content-between align-items-center gap-3 mb-1">
                                        <span class="fw-bold fs-5 text-light">@show.ShowTime.ToString(@"hh\:mm")</span>
                                        <span class="badge bg-danger bg-opacity-25 text-danger fw-bold">₹@show.Price</span>
                                    </div>
                                    <div class="small text-muted mb-1">@show.ShowDate.ToString("ddd, dd MMM")</div>
                                    <div class="small d-flex align-items-center gap-1 text-info">
                                        <i class="bi bi-display"></i> @show.ScreenName
                                    </div>
                                    <div class="small text-success mt-1">
                                        <i class="bi bi-person-check me-1"></i>@show.SeatsAvailable seats available
                                    </div>
                                </a>
                            }
                            else
                            {
                                <div>
                                    <div class="d-flex justify-content-between align-items-center gap-3 mb-1">
                                        <span class="fw-bold fs-5 text-muted">@show.ShowTime.ToString(@"hh\:mm")</span>
                                        <span class="badge bg-secondary text-dark">₹@show.Price</span>
                                    </div>
                                    <div class="small text-muted">@show.ShowDate.ToString("ddd, dd MMM") &bull; @show.ScreenName</div>
                                    <div class="small text-danger mt-1 fw-bold">Sold Out</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    }

    <!-- AI Recommendation Section -->
    @if (recommendations != null && recommendations.Count > 0)
    {
        <div class="mt-5 pt-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
                <div class="d-flex align-items-center gap-2">
                    <h3 class="mb-0">You Might Also Love</h3>
                    <span class="ai-badge"><i class="bi bi-stars"></i> Smart Recommended</span>
                </div>
                <a asp-controller="Movie" asp-action="Index" class="text-muted small">View all</a>
            </div>

            <div class="row g-4">
                @foreach (var rec in recommendations)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <a asp-controller="Movie" asp-action="Details" asp-route-id="@rec.MovieId" class="text-decoration-none h-100 d-block">
                            <div class="movie-card">
                                <div class="movie-poster-wrap">
                                    <img src="@(string.IsNullOrWhiteSpace(rec.PosterUrl) ? "https://placehold.co/400x600/1a1d24/9aa0ab?text=" + Uri.EscapeDataString(rec.Title) : rec.PosterUrl)" class="movie-poster" alt="@rec.Title" />
                                    <div class="movie-poster-overlay">
                                        <button class="btn btn-primary-cinema btn-sm w-100 mb-2">Book Now</button>
                                    </div>
                                </div>
                                <div class="movie-card-body">
                                    <h6 class="movie-card-title" title="@rec.Title">@rec.Title</h6>
                                    <div class="movie-card-meta">@rec.Language &bull; @rec.DurationInMinutes min</div>
                                    <span class="badge-genre genre-primary">@rec.Genre</span>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    }
</div>

