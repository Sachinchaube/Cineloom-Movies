@model List<MovieBookingPro.DTOs.MovieDto>
@{
    ViewData["Title"] = "Movies";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap mb-4">
        <h3 class="mb-0">
            @if (!string.IsNullOrWhiteSpace(ViewBag.Search))
            {
                <text>Results for "@ViewBag.Search"</text>
            }
            else
            {
                <text>All Movies</text>
            }
        </h3>
        <form asp-controller="Movie" asp-action="Index" method="get" class="d-flex search-bar mt-2 mt-md-0">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search movies..." />
            <button type="submit" class="btn btn-search"><i class="bi bi-search"></i></button>
        </form>
    </div>

    @if (Model.Count == 0)
    {
        <p class="text-muted">No movies found. Try a different search term.</p>
    }
    else
    {
        <div class="row g-4">
            @foreach (var movie in Model)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <a asp-controller="Movie" asp-action="Details" asp-route-id="@movie.MovieId" class="text-decoration-none">
                        <div class="movie-card">
                            <img src="@(string.IsNullOrWhiteSpace(movie.PosterUrl) ? "https://placehold.co/400x600/1a1d24/9aa0ab?text=" + Uri.EscapeDataString(movie.Title) : movie.PosterUrl)" class="movie-poster" alt="@movie.Title" />
                            <div class="movie-card-body">
                                <h5>@movie.Title</h5>
                                <div class="movie-meta mb-2">@movie.Language &bull; @movie.DurationInMinutes min</div>
                                <span class="badge-genre">@movie.Genre</span>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>
