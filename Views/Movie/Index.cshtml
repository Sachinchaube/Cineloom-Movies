@model List<MovieBookingPro.DTOs.MovieDto>
@{
    ViewData["Title"] = "Explore Movies";
}

<div class="container py-5">
    <!-- Header with Search Form -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <span class="text-gold fw-bold text-uppercase small" style="letter-spacing: 0.05em;">Catalog</span>
            <h2 class="mb-0 mt-1">
                @if (!string.IsNullOrWhiteSpace(ViewBag.Search))
                {
                    <text>Search Results for "@ViewBag.Search"</text>
                }
                else
                {
                    <text>All Movies</text>
                }
            </h2>
        </div>
        <form asp-controller="Movie" asp-action="Index" method="get" class="search-box-cinema" style="max-width: 400px; width: 100%;">
            <i class="bi bi-search text-muted ms-2"></i>
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by title or genre..." />
            <button type="submit" class="btn-search py-2 px-3">
                <i class="bi bi-search"></i>
            </button>
        </form>
    </div>

    <!-- Genre Filter Tabs -->
    <div class="d-flex flex-wrap gap-2 mb-4 pb-2">
        <a asp-controller="Movie" asp-action="Index" class="badge-genre @(string.IsNullOrEmpty(ViewBag.Search) ? "genre-active" : "") text-decoration-none px-3 py-2">All Genres</a>
        <a asp-controller="Movie" asp-action="Index" asp-route-search="Sci-Fi" class="badge-genre text-decoration-none px-3 py-2">Sci-Fi</a>
        <a asp-controller="Movie" asp-action="Index" asp-route-search="Action" class="badge-genre text-decoration-none px-3 py-2">Action</a>
        <a asp-controller="Movie" asp-action="Index" asp-route-search="Drama" class="badge-genre text-decoration-none px-3 py-2">Drama</a>
        <a asp-controller="Movie" asp-action="Index" asp-route-search="Animation" class="badge-genre text-decoration-none px-3 py-2">Animation</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="panel text-center py-5">
            <i class="bi bi-film fs-1 text-muted d-block mb-3"></i>
            <h4 class="text-light">No Movies Found</h4>
            <p class="text-muted mb-3">There are no titles matching your search criteria.</p>
            <a asp-controller="Movie" asp-action="Index" class="btn btn-cinema-gold btn-sm">Clear Search Filter</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var movie in Model)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <a asp-controller="Movie" asp-action="Details" asp-route-id="@movie.MovieId" class="text-decoration-none h-100 d-block">
                        <div class="movie-card">
                            <div class="movie-poster-wrap">
                                <span class="badge-rating"><i class="bi bi-star-fill"></i> 9.@((movie.MovieId * 2 + 1) % 9)</span>
                                <img src="@(string.IsNullOrWhiteSpace(movie.PosterUrl) ? "https://placehold.co/400x600/101622/94a3b8?text=" + Uri.EscapeDataString(movie.Title) : movie.PosterUrl)" class="movie-poster" alt="@movie.Title" />
                                <div class="movie-poster-overlay">
                                    <div class="btn btn-cinema-gold btn-sm w-100 mb-2">
                                        View Showtimes
                                    </div>
                                </div>
                            </div>
                            <div class="movie-card-body">
                                <h5 class="movie-card-title" title="@movie.Title">@movie.Title</h5>
                                <div class="movie-card-meta">
                                    <span>@movie.Language</span>
                                    <span>&bull;</span>
                                    <span>@movie.DurationInMinutes min</span>
                                </div>
                                <div class="mt-auto d-flex justify-content-between align-items-center">
                                    <span class="badge-genre">@movie.Genre</span>
                                    <span class="text-muted small">@movie.ReleaseDate.ToString("yyyy")</span>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>
