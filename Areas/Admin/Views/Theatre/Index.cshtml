@model List<MovieBookingPro.DTOs.TheatreDto>
@{
    ViewData["Title"] = "Theatres Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0 text-light fw-bold">Multiplex Locations</h4>
        <small class="text-muted">Total @Model.Count locations</small>
    </div>
    <a asp-action="Create" class="btn btn-cinema-gold btn-sm"><i class="bi bi-plus-lg me-1"></i>Add Theatre</a>
</div>

<div class="panel">
    <div class="table-responsive">
        <table class="table table-cinema mb-0">
            <thead>
                <tr>
                    <th>Theatre Name</th>
                    <th>City Location</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <strong class="text-light">@item.Name</strong>
                            <small class="text-muted d-block">ID: #THT-@item.TheatreId</small>
                        </td>
                        <td>
                            <span class="text-light">@item.Location</span>
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@item.TheatreId" class="btn btn-sm btn-cinema-subtle">
                                    Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.TheatreId" class="btn btn-sm btn-outline-danger">
                                    Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
