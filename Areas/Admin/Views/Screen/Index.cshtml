@model List<MovieBookingPro.DTOs.ScreenDto>
@{
    ViewData["Title"] = "Screens Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0 text-light fw-bold">Cinema Auditoriums & Screens</h4>
        <small class="text-muted">Total @Model.Count screens configured</small>
    </div>
    <a asp-action="Create" class="btn btn-primary-cinema"><i class="bi bi-plus-lg me-1"></i>Add New Screen</a>
</div>

<div class="panel p-4">
    <div class="table-responsive">
        <table class="table table-cinema mb-0">
            <thead>
                <tr>
                    <th>Screen Name</th>
                    <th>Theatre Complex</th>
                    <th>Seat Capacity</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <div class="p-2 rounded bg-primary bg-opacity-10 text-primary fs-5">
                                    <i class="bi bi-display"></i>
                                </div>
                                <div>
                                    <strong class="text-light fs-6">@item.ScreenName</strong>
                                    <small class="text-muted d-block">ID: #SCR-@item.ScreenId</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="text-light"><i class="bi bi-building text-info me-1"></i>@item.TheatreName</span>
                        </td>
                        <td>
                            <span class="badge-seat-cap"><i class="bi bi-person-fill me-1"></i>@item.SeatCapacity Seats</span>
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@item.ScreenId" class="btn btn-sm btn-outline-warning">
                                    <i class="bi bi-pencil me-1"></i>Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.ScreenId" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash3 me-1"></i>Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

