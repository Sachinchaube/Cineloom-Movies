<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MovieNest Admin</title>
    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="admin-wrapper">
        <!-- Sidebar Navigation -->
        <aside class="admin-sidebar">
            <div class="brand">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="text-decoration-none">
                    <div class="d-flex align-items-center gap-2">
                        <span class="brand-mark"><i class="bi bi-film"></i></span>
                        <h5 class="mb-0 font-brand fw-bold text-light">Movie<span class="text-gold">Nest</span></h5>
                    </div>
                </a>
                <div class="text-muted small mt-2">Administration Portal</div>
            </div>
            
            <nav class="nav flex-column">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Movie" ? "active" : "")" asp-area="Admin" asp-controller="Movie" asp-action="Index">
                    <i class="bi bi-camera-reels"></i> Movies
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Theatre" ? "active" : "")" asp-area="Admin" asp-controller="Theatre" asp-action="Index">
                    <i class="bi bi-building"></i> Theatres
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Screen" ? "active" : "")" asp-area="Admin" asp-controller="Screen" asp-action="Index">
                    <i class="bi bi-display"></i> Screens
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ShowSchedule" ? "active" : "")" asp-area="Admin" asp-controller="ShowSchedule" asp-action="Index">
                    <i class="bi bi-calendar3"></i> Show Schedules
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Booking" ? "active" : "")" asp-area="Admin" asp-controller="Booking" asp-action="Index">
                    <i class="bi bi-ticket-perforated"></i> Bookings
                </a>
            </nav>

            <div class="mt-auto pt-4 border-top border-secondary border-opacity-25 px-3">
                <a class="btn btn-cinema-subtle w-100 btn-sm mb-2" asp-area="" asp-controller="Home" asp-action="Index">
                    Customer Portal
                </a>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-outline-danger w-100 btn-sm">
                        Sign Out
                    </button>
                </form>
            </div>
        </aside>

        <!-- Main Content Area -->
        <div class="admin-content">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom" style="border-color: var(--border-subtle) !important;">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Overview</span>
                    <h2 class="mb-0 text-light fw-bold">@ViewData["Title"]</h2>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="badge-muted">
                        @DateTime.Now.ToString("dd MMM yyyy")
                    </span>
                    <div class="d-flex align-items-center gap-2 p-1 pe-3 rounded-pill bg-dark border border-secondary border-opacity-25">
                        <div class="rounded-circle bg-secondary text-light d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; font-size: 0.8rem;">
                            <i class="bi bi-person"></i>
                        </div>
                        <span class="text-light small">Administrator</span>
                    </div>
                </div>
            </div>

            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.3/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
