@model List<MovieBookingPro.DTOs.BookingDto>
@{
    ViewData["Title"] = "Customer Bookings";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0 text-light fw-bold">Customer Reservations & Bookings</h4>
        <small class="text-muted">Total @Model.Count transactions logged</small>
    </div>
</div>

<div class="panel p-4">
    <div class="table-responsive">
        <table class="table table-cinema mb-0">
            <thead>
                <tr>
                    <th>Ref ID</th>
                    <th>Customer Name</th>
                    <th>Movie Title</th>
                    <th>Theatre / Screen</th>
                    <th>Showtime</th>
                    <th>Seats</th>
                    <th>Total Paid</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><span class="font-grotesk fw-bold text-light">#CIN-@item.BookingId.ToString("D5")</span></td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle bg-dark border border-secondary border-opacity-50 text-muted d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; font-size: 0.75rem;">
                                    <i class="bi bi-person"></i>
                                </div>
                                <strong class="text-light">@item.UserName</strong>
                            </div>
                        </td>
                        <td><strong class="text-light">@item.MovieTitle</strong></td>
                        <td><span class="text-muted small">@item.TheatreName &bull; <span class="text-info">@item.ScreenName</span></span></td>
                        <td>@item.ShowDate.ToString("dd MMM yyyy") @item.ShowTime.ToString(@"hh\:mm")</td>
                        <td><span class="text-danger fw-bold">@item.SeatCount</span></td>
                        <td><strong class="text-success fs-6">₹@item.TotalAmount</strong></td>
                        <td>
                            @if (item.Status == "Confirmed")
                            {
                                <span class="badge-confirmed"><i class="bi bi-check-circle me-1"></i>Confirmed</span>
                            }
                            else
                            {
                                <span class="badge-cancelled"><i class="bi bi-x-circle me-1"></i>Cancelled</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (item.Status == "Confirmed")
                            {
                                <form asp-action="Cancel" asp-route-id="@item.BookingId" method="post" onsubmit="return confirm('Cancel this customer booking?');" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-x-circle me-1"></i>Cancel
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

