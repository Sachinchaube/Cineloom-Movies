@model List<MovieBookingPro.DTOs.BookingDto>
@{
    ViewData["Title"] = "Customer Bookings";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0 text-light fw-bold">Customer Reservations</h4>
        <small class="text-muted">Total @Model.Count transactions logged</small>
    </div>
</div>

<div class="panel">
    <div class="table-responsive">
        <table class="table table-cinema mb-0">
            <thead>
                <tr>
                    <th>Ref ID</th>
                    <th>Customer</th>
                    <th>Movie</th>
                    <th>Theatre / Screen</th>
                    <th>Showtime</th>
                    <th>Seats</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><span class="font-monospace text-light">#NEST-@item.BookingId.ToString("D5")</span></td>
                        <td><strong class="text-light">@item.UserName</strong></td>
                        <td>@item.MovieTitle</td>
                        <td><span class="text-muted small">@item.TheatreName &bull; @item.ScreenName</span></td>
                        <td>@item.ShowDate.ToString("dd MMM yyyy") @item.ShowTime.ToString(@"hh\:mm")</td>
                        <td><span class="text-gold fw-bold">@item.SeatCount</span></td>
                        <td><strong class="text-gold">₹@item.TotalAmount</strong></td>
                        <td>
                            @if (item.Status == "Confirmed")
                            {
                                <span class="badge-confirmed">Confirmed</span>
                            }
                            else
                            {
                                <span class="badge-cancelled">Cancelled</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (item.Status == "Confirmed")
                            {
                                <form asp-action="Cancel" asp-route-id="@item.BookingId" method="post" onsubmit="return confirm('Cancel this customer booking?');" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        Cancel
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
