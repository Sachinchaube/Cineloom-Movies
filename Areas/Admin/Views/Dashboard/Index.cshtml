@{
    ViewData["Title"] = "Executive Dashboard";
}

<!-- Metrics Summary -->
<div class="row g-4 mb-5">
    <div class="col-lg-4 col-md-6">
        <div class="stat-card">
            <div class="stat-icon">
                <i class="bi bi-camera-reels"></i>
            </div>
            <div class="stat-value">@ViewBag.MovieCount</div>
            <div class="stat-label">Movies in Catalog</div>
        </div>
    </div>

    <div class="col-lg-4 col-md-6">
        <div class="stat-card">
            <div class="stat-icon">
                <i class="bi bi-building"></i>
            </div>
            <div class="stat-value">@ViewBag.TheatreCount</div>
            <div class="stat-label">Theatre Locations</div>
        </div>
    </div>

    <div class="col-lg-4 col-md-6">
        <div class="stat-card">
            <div class="stat-icon">
                <i class="bi bi-display"></i>
            </div>
            <div class="stat-value">@ViewBag.ScreenCount</div>
            <div class="stat-label">Auditorium Screens</div>
        </div>
    </div>

    <div class="col-lg-4 col-md-6">
        <div class="stat-card">
            <div class="stat-icon">
                <i class="bi bi-calendar3"></i>
            </div>
            <div class="stat-value">@ViewBag.ShowCount</div>
            <div class="stat-label">Active Showtimes</div>
        </div>
    </div>

    <div class="col-lg-4 col-md-6">
        <div class="stat-card">
            <div class="stat-icon">
                <i class="bi bi-ticket-perforated"></i>
            </div>
            <div class="stat-value">@ViewBag.BookingCount</div>
            <div class="stat-label">Total Bookings</div>
        </div>
    </div>

    <div class="col-lg-4 col-md-6">
        <div class="stat-card">
            <div class="stat-icon">
                <i class="bi bi-currency-rupee"></i>
            </div>
            <div class="stat-value text-gold">₹@ViewBag.TotalRevenue</div>
            <div class="stat-label">Box Office Revenue</div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="panel mb-4">
    <h5 class="text-light fw-bold mb-3">Quick Actions</h5>
    <div class="row g-3">
        <div class="col-12 col-sm-6 col-lg-3">
            <a asp-area="Admin" asp-controller="Movie" asp-action="Create" class="quick-action-card text-decoration-none">
                <div class="fw-bold text-light mb-1">Add Movie</div>
                <div class="text-muted small">New title entry</div>
            </a>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <a asp-area="Admin" asp-controller="Theatre" asp-action="Create" class="quick-action-card text-decoration-none">
                <div class="fw-bold text-light mb-1">Add Theatre</div>
                <div class="text-muted small">New multiplex facility</div>
            </a>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <a asp-area="Admin" asp-controller="Screen" asp-action="Create" class="quick-action-card text-decoration-none">
                <div class="fw-bold text-light mb-1">Add Screen</div>
                <div class="text-muted small">Configure capacity</div>
            </a>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <a asp-area="Admin" asp-controller="ShowSchedule" asp-action="Create" class="quick-action-card text-decoration-none">
                <div class="fw-bold text-light mb-1">Schedule Show</div>
                <div class="text-muted small">Set date, time & price</div>
            </a>
        </div>
    </div>
</div>
