@model List<MovieBookingPro.DTOs.MovieDto>
@{
    ViewData["Title"] = "Movies Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0 text-light fw-bold">Movie Titles</h4>
        <small class="text-muted">Total @Model.Count titles in catalog</small>
    </div>
    <a asp-action="Create" class="btn btn-cinema-gold btn-sm"><i class="bi bi-plus-lg me-1"></i>Add Movie</a>
</div>

<div class="panel">
    <div class="table-responsive">
        <table class="table table-cinema mb-0">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Genre</th>
                    <th>Language</th>
                    <th>Duration</th>
                    <th>Release Date</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <img src="@(string.IsNullOrWhiteSpace(item.PosterUrl) ? "https://placehold.co/100x150/101622/94a3b8?text=" + Uri.EscapeDataString(item.Title) : item.PosterUrl)" 
                                     class="rounded-1" 
                                     style="width: 36px; height: 50px; object-fit: cover;" 
                                     alt="@item.Title" />
                                <div>
                                    <strong class="text-light">@item.Title</strong>
                                    <small class="text-muted d-block">ID: #MOV-@item.MovieId</small>
                                </div>
                            </div>
                        </td>
                        <td><span class="badge-genre">@item.Genre</span></td>
                        <td>@item.Language</td>
                        <td>@item.DurationInMinutes min</td>
                        <td>@item.ReleaseDate.ToString("dd MMM yyyy")</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@item.MovieId" class="btn btn-sm btn-cinema-subtle">
                                    Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.MovieId" class="btn btn-sm btn-outline-danger">
                                    Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
