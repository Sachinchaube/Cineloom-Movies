@model List<MovieBookingPro.DTOs.MovieDto>
@{
    ViewData["Title"] = "Movies Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0 text-light fw-bold">Active Movies Catalog</h4>
        <small class="text-muted">Total @Model.Count movie titles registered</small>
    </div>
    <a asp-action="Create" class="btn btn-primary-cinema"><i class="bi bi-plus-lg me-1"></i>Add New Movie</a>
</div>

<div class="panel p-4">
    <div class="table-responsive">
        <table class="table table-cinema mb-0">
            <thead>
                <tr>
                    <th>Movie Title</th>
                    <th>Genre</th>
                    <th>Language</th>
                    <th>Duration</th>
                    <th>Release Date</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <img src="@(string.IsNullOrWhiteSpace(item.PosterUrl) ? "https://placehold.co/100x150/1a1d24/9aa0ab?text=" + Uri.EscapeDataString(item.Title) : item.PosterUrl)" 
                                     class="rounded-2" 
                                     style="width: 40px; height: 55px; object-fit: cover;" 
                                     alt="@item.Title" />
                                <div>
                                    <strong class="text-light fs-6">@item.Title</strong>
                                    <small class="text-muted d-block">ID: #MOV-@item.MovieId</small>
                                </div>
                            </div>
                        </td>
                        <td><span class="badge-genre genre-primary">@item.Genre</span></td>
                        <td><i class="bi bi-translate text-muted me-1"></i>@item.Language</td>
                        <td><i class="bi bi-clock text-muted me-1"></i>@item.DurationInMinutes min</td>
                        <td>@item.ReleaseDate.ToString("dd MMM yyyy")</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@item.MovieId" class="btn btn-sm btn-outline-warning">
                                    <i class="bi bi-pencil me-1"></i>Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.MovieId" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash3 me-1"></i>Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

