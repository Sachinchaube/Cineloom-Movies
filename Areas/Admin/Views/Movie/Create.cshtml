@model MovieBookingPro.DTOs.MovieCreateDto
@{
    ViewData["Title"] = "Add Movie";
}

<h3 class="mb-4">Add New Movie</h3>

<div class="panel" style="max-width: 700px;">
    <form asp-action="Insert" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Title"></label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger small"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Genre"></label>
                <input asp-for="Genre" class="form-control" />
                <span asp-validation-for="Genre" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Language"></label>
                <input asp-for="Language" class="form-control" />
                <span asp-validation-for="Language" class="text-danger small"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="DurationInMinutes"></label>
                <input asp-for="DurationInMinutes" class="form-control" />
                <span asp-validation-for="DurationInMinutes" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="ReleaseDate"></label>
                <input asp-for="ReleaseDate" class="form-control" />
                <span asp-validation-for="ReleaseDate" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="PosterUrl"></label>
            <input asp-for="PosterUrl" class="form-control" placeholder="https://example.com/poster.jpg (optional)" />
            <span asp-validation-for="PosterUrl" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-primary-cinema">Save Movie</button>
        <a asp-action="Index" class="btn btn-outline-light">Cancel</a>
    </form>
</div>
