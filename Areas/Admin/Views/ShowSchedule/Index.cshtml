@model List<MovieBookingPro.DTOs.ShowScheduleDto>
@{
    ViewData["Title"] = "Show Schedules";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0 text-light fw-bold">Active Showtimes</h4>
        <small class="text-muted">Total @Model.Count schedules</small>
    </div>
    <a asp-action="Create" class="btn btn-cinema-gold btn-sm"><i class="bi bi-plus-lg me-1"></i>Schedule Show</a>
</div>

<div class="panel">
    <div class="table-responsive">
        <table class="table table-cinema mb-0">
            <thead>
                <tr>
                    <th>Movie</th>
                    <th>Theatre</th>
                    <th>Screen</th>
                    <th>Date & Time</th>
                    <th>Price</th>
                    <th>Booked / Total</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <strong class="text-light">@item.MovieTitle</strong>
                            <small class="text-muted d-block">ID: #SHW-@item.ShowId</small>
                        </td>
                        <td>@item.TheatreName</td>
                        <td><span class="badge-muted">@item.ScreenName</span></td>
                        <td>
                            <strong class="text-light">@item.ShowDate.ToString("dd MMM yyyy")</strong>
                            <span class="text-muted ms-1">@item.ShowTime.ToString(@"hh\:mm")</span>
                        </td>
                        <td><strong class="text-gold">₹@item.Price</strong></td>
                        <td>
                            <div class="small text-muted">@item.SeatsBooked / @item.SeatCapacity</div>
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@item.ShowId" class="btn btn-sm btn-cinema-subtle">
                                    Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.ShowId" class="btn btn-sm btn-outline-danger">
                                    Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
