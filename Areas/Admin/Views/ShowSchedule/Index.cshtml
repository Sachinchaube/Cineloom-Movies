@model List<MovieBookingPro.DTOs.ShowScheduleDto>
@{
    ViewData["Title"] = "Show Schedules";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">Show Schedules</h3>
    <a asp-action="Create" class="btn btn-primary-cinema"><i class="bi bi-plus-lg me-1"></i>Add New Show</a>
</div>

<div class="panel">
    <table class="table table-cinema mb-0">
        <thead>
            <tr>
                <th>Movie</th>
                <th>Theatre</th>
                <th>Screen</th>
                <th>Date</th>
                <th>Time</th>
                <th>Price</th>
                <th>Seats</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.MovieTitle</td>
                    <td>@item.TheatreName</td>
                    <td>@item.ScreenName</td>
                    <td>@item.ShowDate.ToString("dd-MMM-yyyy")</td>
                    <td>@item.ShowTime.ToString(@"hh\:mm")</td>
                    <td>₹@item.Price</td>
                    <td>@item.SeatsBooked / @item.SeatCapacity</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.ShowId" class="btn btn-sm btn-outline-cinema">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.ShowId" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
